#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>


#define DEFAULT 0
#define NUM     1
#define SYM     2
#define NAV     3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

/ {
    chosen {
       zmk,matrix_transform = &ortho_transform;
    };

conditional_layers {
        compatible = "zmk,conditional-layers";
	tri_layer {
        if-layers = <1 2>;
	    then-layer = <3>;
			};
   	 	};
	};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
 &kp Q       &kp W  &kp F  &kp P  &kp B  &none     &none  &kp J  &kp L  &kp U      &kp Y    &kp APOS
 &kp A       &kp R  &kp S  &kp T  &kp G  &none     &none  &kp M  &kp N  &kp E      &kp I    &kp O 
 &mt LSHFT Z &kp X  &kp C  &kp D  &kp V  &none     &none  &kp K  &kp H  &kp COMMA  &kp DOT  &mt RSHFT FSLH
        &none &lt 2 MINUS &lt 1 BSPC &sk LSHFT     &kp LC(BSPC) &kp SPACE &mt LCTRL SEMI &none    
            >;
        };

        num_layer {
            bindings = <
&kp EXCL       &kp AT   &kp POUND &kp DLLR  &kp PRCNT &none    &none &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
&kp N1         &kp N2   &kp N3    &kp N4    &kp N5    &none    &none &kp N6    &kp N7   &kp N8    &kp N9   &kp N0  
&mt LSHFT BSLH &kp LBKT &kp RBKT  &kp GRAVE &kp TILDE &none    &none &kp MINUS &kp PLUS &kp COMMA &kp DOT  &mt RSHFT FSLH
                        &none     &trans    &trans   &trans    &kp BSPC &kp SPACE &kp EQUAL &none
            >;
        };

        sym_layer {
            bindings = <
&kp ESC   &none     &kp PG_UP  &kp INS  &none  &none     &none  &none    &kp HOME  &kp UP    &kp END   &none
&kp TAB   &kp CAPS  &kp PG_DN  &none    &none  &none     &none  &kp DEL  &kp LEFT  &kp DOWN  &kp RIGHT &kp RET
&kp LSHFT &kp LCTRL &kp LALT   &sk LGUI &none  &none     &none  &none    &sk RGUI  &kp RALT  &kp RCTRL &kp RSHFT
                    &none      &trans   &trans &mo 3     &kp LC(BSPC) &kp SPACE &kp BSPC &none
            >;
        };

        nav_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &bootloader &none      &none &none &none &none &none &none
&none         &none        &none        &none      &none       &none      &none &none &none &none &none &none
&none         &none        &none        &none      &none       &none      &none &none &none &none &none &none
                           &bt BT_CLR_ALL  &trans  &trans     &trans      &none &none &none &none
            >;
        };

    };
};

